# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Egbe secrets and machine-local files; working artifacts belong in Git.
/egbe-docs/**/.local/
/egbe-docs/**/*.lock
/egbe-docs/**/*.tmp
/egbe-docs/**/*-wal
/egbe-docs/**/*-shm
/egbe-docs/**/*-journal
!/egbe-docs/marketing/campaigns/instantly/outreach.db
